    <TIER ANNOTATOR="@aak2008m" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@eas2008f" PARTICIPANT="@eas2008f" TIER_ID="gestComment@eas2008f">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449"
                TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>мне кажется, этот жесть может как указывать на "вот" и переход к продолжению, либо выражать внутреннее беспокойство, которое потом выражается ногами</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a450"
                TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>аналогично. сочетание беспокойства и структурирования речи руками</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451"
                TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>тут скорее идёт подбор слова, но на этом процессе делается акцент, я не уверен, прагматический это жест или адаптор</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a452"
                TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>тут идёт речь о системе, но сам жест ничего не значит, просто помогает держать в голове структуру и усиливает интонацию</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a453"
                TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>своеброзаное перечисление становится акцентуационным жестом, поддерживающим интонацию</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454"
                TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>сильно поднимает брови, пытаясь вспомнить конкретный год</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455"
                TIME_SLOT_REF1="ts254" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>либо это снова прагматический интонационный жест, либо это адаптор, для объяснения и подавления беспокойства</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a456"
                TIME_SLOT_REF1="ts334" TIME_SLOT_REF2="ts345">
                <ANNOTATION_VALUE>снова очень сильно подняла брови (я не размечал постоянное верчение колец на руках и совсем мелкую мимику)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
